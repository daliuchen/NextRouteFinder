{
  "name": "next-route-finder",
  "displayName": "Next.js Route Finder",
  "description": "Quickly locate Next.js pages by route path",
  "author": "EthanLiuChen",
  "publisher": "EthanLiuChen",
  "icon": "icon.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "license": "MIT",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:next-route-finder.findRoute"
  ],
  "main": "./out/extension.js",
  "repository": "https://github.com/daliuchen/NextRouteFinder",
  "contributes": {
    "commands": [
      {
        "command": "next-route-finder.findRoute",
        "title": "Find Next.js Route"
      }
    ],
    "configuration": {
      "title": "Next.js Route Finder",
      "properties": {
        "nextRouteFinder.include": {
          "type": "array",
          "default": [
            "page",
            "route"
          ],
          "items": {
            "type": "string",
            "enum": [
              "page",
              "layout",
              "route"
            ],
            "enumDescriptions": [
              "Pages (app/**/page.tsx, pages/**/*.tsx)",
              "Layouts (app/**/layout.tsx) — shares its route with the sibling page, so it shows up as a second entry",
              "Route handlers (app/**/route.ts, pages/api/**)"
            ]
          },
          "uniqueItems": true,
          "markdownDescription": "Which files to index as routes. Removing `layout` keeps one entry per route."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^16.11.7",
    "@typescript-eslint/eslint-plugin": "^5.30.5",
    "@typescript-eslint/parser": "^5.30.5",
    "eslint": "^8.18.0",
    "typescript": "^4.7.4"
  },
  "packageManager": "pnpm@8.15.4"
} 